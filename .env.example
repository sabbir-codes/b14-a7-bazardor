# Postgres (Neon / Supabase / Vercel Postgres) - used by Better Auth
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Social login (optional - buttons show an error toast if not configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Market API (defaults are already set in code)
BAZAR_API_1=https://api.api-store.workers.dev/api/bazardor
BAZAR_API_2=https://api.abcz.workers.dev/api/bazardor
